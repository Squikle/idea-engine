{
  "IdeaEngine": {
    "Ai": {
      "OpenRouterBaseUrl": "https://openrouter.ai/api/v1/",
      "Budget": {
        "GlobalDailyUsdCap": 5.0,
        "GlobalMonthlyUsdCap": 60.0,
        "MaxUsdPerCall": 0.15
      },
      "Glance": {
        "Model": "openai/gpt-5-nano",
        "InputPricePerMTok": 0.05,
        "OutputPricePerMTok": 0.40,
        "DailyUsdCap": 0.10
      },
      "Research": {
        "Enabled": true,
        "Model": "anthropic/claude-sonnet-5",
        "InputPricePerMTok": 2.0,
        "OutputPricePerMTok": 10.0,
        "DailyUsdCap": 2.0,
        "MaxQueries": 6,
        "ResultsPerQuery": 5,
        "MaxCompletionTokens": 6000,
        "ReasoningEffort": "medium"
      },
      "Ideation": {
        "Enabled": true,
        "BuilderModel": "anthropic/claude-sonnet-5",
        "BuilderInputPricePerMTok": 2.0,
        "BuilderOutputPricePerMTok": 10.0,
        "SkepticModel": "deepseek/deepseek-v4-pro",
        "SkepticInputPricePerMTok": 0.43,
        "SkepticOutputPricePerMTok": 0.87,
        "DailyUsdCap": 3.0,
        "MaxSessionsPerCommand": 10,
        "SignalsPerSession": 24,
        "SignalPoolSize": 80,
        "MinSignalConfidence": 0.35,
        "MaxCompletionTokens": 4000,
        "ReasoningEffort": "medium"
      },
      "Triage": {
        "Enabled": true,
        "Model": "openai/gpt-5-nano",
        "InputPricePerMTok": 0.05,
        "OutputPricePerMTok": 0.40,
        "DailyUsdCap": 1.0,
        "MaxCompletionTokens": 3000,
        "ReasoningEffort": "low",
        "BatchSize": 8,
        "Parallelism": 4,
        "PollSecondsBusy": 15,
        "PollSecondsIdle": 120
      }
    },
    "Ingestion": {
      "RunOnStartup": true,
      "IntervalHours": 3,
      "MaxItemsPerSource": 60,
      "VerboseItemLogging": true,
      "NotifyEveryCycle": true
    },
    "Sources": {
      "HackerNews": {
        "FrontPageLimit": 30,
        "AskHnLimit": 25,
        "MinAskPoints": 5,
        "CommentsPerItem": 12
      },
      "FourChan": {
        "ThreadsPerBoard": 12,
        "MinReplies": 20,
        "CommentsPerThread": 12
      },
      "Bluesky": {
        "LimitPerQuery": 25,
        "MinLikes": 3
      },
      "Lemmy": {
        "ListLimit": 40,
        "MinScore": 15,
        "TakeTop": 20,
        "CommentsPerPost": 12
      },
      "RedditRss": {
        "PerSubredditLimit": 10
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/idea-engine-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
