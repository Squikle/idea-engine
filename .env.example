# ---------------------------------------------------------------------------
# Copy to `.env` (gitignored) and fill in. NEVER commit .env.
# NEVER paste real key values into AI chats - set them here yourself;
# the assistant only ever references variable NAMES.
# ---------------------------------------------------------------------------

# --- Postgres (local container; see docker-compose.yml) ---
POSTGRES_USER=ideaengine
POSTGRES_PASSWORD=change-me-random
POSTGRES_DB=ideaengine
# Host port. 5433 avoids clashing with any existing Postgres on 5432.
DB_PORT=5433

# --- Phase 1+: filled during guided setup (docs/RUNBOOK.md) ---

# Telegram: token from @BotFather; chat id of your own chat with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# OpenRouter: one key for triage/screen models (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Brave Search API (https://api-dashboard.search.brave.com).
BRAVE_API_KEY=

# Reddit "script" app credentials (https://www.reddit.com/prefs/apps).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Used only to build the required descriptive User-Agent string.
REDDIT_USERNAME=
